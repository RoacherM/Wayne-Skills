// ── Template: rendering logic ─────────────────────────
function getAfterData(qLabel) {
  return [
'// Track builder — groups commits into trunk + scoped sub-tracks',
'function buildTracks(data) {',
'  return data.krs.map(kr => {',
'    const trunk = [], scopeMap = new Map(), scopeOrder = [];',
'    for (const c of kr.commits) {',
'      if (c.scope) {',
'        if (!scopeMap.has(c.scope)) { scopeMap.set(c.scope, []); scopeOrder.push(c.scope); }',
'        scopeMap.get(c.scope).push(c);',
'      } else trunk.push(c);',
'    }',
'    const scopes = scopeOrder.map(name => {',
'      const cs = scopeMap.get(name), last = cs[cs.length-1];',
'      let status = "active";',
'      if (last.prefix === "done") status = "merged";',
'      else if (last.prefix === "blocked") status = "blocked";',
'      const bSegs = []; let bs = null;',
'      for (const c of cs) {',
'        if (c.prefix === "blocked" && !bs) bs = c.date;',
'        else if (c.prefix !== "blocked" && bs) { bSegs.push({start:bs, end:c.date}); bs=null; }',
'      }',
'      if (bs) bSegs.push({start:bs, end:last.date});',
'      return { name, commits:cs, status, forkDate:cs[0].date,',
'        mergeDate: status==="merged" ? last.date : null, blockedSegments:bSegs };',
'    });',
'    return { id:kr.id, name:kr.name, alias:kr.alias, color:kr.color, state:kr.state,',
'      trunk:{commits:trunk}, scopes, mergeDate:kr.mergeDate };',
'  });',
'}',
'',
'// Vertical layout engine',
'const C = {',
'  mL: 60, mT: 20, labelH: 64, mB: 40,',
'  mainX: 60, krGap: 48, sGap: 28, pxDay: 10,',
'  arcR: 16,',
'  trunkW: 6, scopeW: 3, mainW: 3,',
'  dotR: 8, sDotR: 6,',
'};',
'',
'function dMs(d) { return new Date(d).getTime(); }',
'const DAY = 86400000;',
'',
'function computeLayout(tracks, data) {',
'  const allD = [];',
'  for (const t of tracks) {',
'    for (const c of t.trunk.commits) allD.push(dMs(c.date));',
'    for (const s of t.scopes) for (const c of s.commits) allD.push(dMs(c.date));',
'  }',
'  for (const a of data.admin) allD.push(dMs(a.date));',
'',
'  if (allD.length === 0) return { width: 700, height: 200, grid: [], todayY: null, mainX: C.mainX, mainY1: 0, mainY2: 0, mainForks: [], krCols: [], topY: 0, labelH: 0 };',
'',
'  const minD = Math.min(...allD), maxD = Math.max(...allD);',
'  const days = (maxD - minD) / DAY;',
'  const trackH = Math.max(days * C.pxDay, 100);',
'  const topY = C.mT + C.labelH;',
'  const toY = d => topY + ((dMs(d) - minD) / (maxD - minD)) * trackH;',
'',
'  // Fixed column grid',
'  const slotScopes = new Array(DATA.totalSlots).fill(0);',
'  for (const q of DATA.quarters) {',
'    for (const kr of q.krs) {',
'      const sc = kr.commits.filter(c => c.scope).map(c => c.scope);',
'      const uniqueScopes = [...new Set(sc)].length;',
'      if (kr.slotIdx >= 0) slotScopes[kr.slotIdx] = Math.max(slotScopes[kr.slotIdx], uniqueScopes);',
'    }',
'  }',
'  let x = C.mainX + 28;',
'  const slotX = slotScopes.map(sc => {',
'    const sx = x;',
'    x += C.sGap * (Math.max(sc, 0) + 1) + C.krGap;',
'    return sx;',
'  });',
'  const totalW = Math.max(x, 700);',
'',
'  const cols = tracks.map((tr, ti) => {',
'    const kr = data.krs[ti];',
'    if (!kr || kr.slotIdx < 0) return { trunkX: 0, scopes: [], rightEdge: 0 };',
'    const trunkX = slotX[kr.slotIdx];',
'    const col = { trunkX, scopes: [] };',
'    let sx = trunkX + C.sGap;',
'    for (const sc of tr.scopes) { col.scopes.push({ x: sx }); sx += C.sGap; }',
'    col.rightEdge = sx;',
'    return col;',
'  });',
'',
'  const grid = [];',
'  const mn = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];',
'  const cur = new Date(minD); cur.setDate(cur.getDate() - cur.getDay());',
'  const end = new Date(maxD); end.setDate(end.getDate() + 7);',
'  while (cur <= end) {',
'    const iso = cur.toISOString().slice(0,10);',
'    const y = toY(iso);',
'    if (y >= topY - 5 && y <= topY + trackH + 10)',
'      grid.push({ y, label: mn[cur.getMonth()] + " " + cur.getDate() });',
'    cur.setDate(cur.getDate() + 7);',
'  }',
'',
'  const todayMs = dMs(DATA.today);',
'  const todayY = (todayMs >= minD && todayMs <= maxD) ? toY(DATA.today) : null;',
'',
'  // Main fork points — where KR tracks branch from main',
'  const mainForks = tracks.filter(tr => tr.trunk.commits.length > 0 || tr.scopes.some(s=>s.commits.length>0)).map((tr, i) => {',
'    const all = [...tr.trunk.commits, ...tr.scopes.flatMap(s=>s.commits)];',
'    if (all.length === 0) return null;',
'    const firstDate = all.reduce((a,b) => a.date < b.date ? a : b).date;',
'    const ci = tracks.indexOf(tr);',
'    return { y: toY(firstDate), targetX: cols[ci].trunkX, krId: tr.id, color: tr.color };',
'  }).filter(Boolean);',
'',
'  // Main merge-back points',
'  const mainMerges = tracks.filter(tr => tr.mergeDate).map((tr) => {',
'    const ci = tracks.indexOf(tr);',
'    return { y: toY(tr.mergeDate), targetX: cols[ci].trunkX, krId: tr.id, color: tr.color };',
'  });',
'',
'  const krCols = tracks.map((tr, i) => {',
'    const cl = cols[i];',
'    const inactive = tr.state === "canceled" || tr.state === "frozen";',
'    const op = inactive ? 0.35 : 1;',
'',
'    const allTrDates = [...tr.trunk.commits, ...tr.scopes.flatMap(s=>s.commits)].map(c=>c.date);',
'    if (allTrDates.length === 0) return null;',
'    const y1 = toY(allTrDates.reduce((a,b) => a<b ? a : b));',
'    const y2 = tr.mergeDate ? toY(tr.mergeDate) : toY(allTrDates.reduce((a,b) => a>b ? a : b));',
'',
'    const trunkDots = tr.trunk.commits.map(c => ({',
'      y: toY(c.date), prefix: c.prefix, msg: c.msg, date: c.date,',
'      milestone: c.milestone',
'    }));',
'',
'    const scopeLayouts = tr.scopes.map((sc, si) => {',
'      const sx = cl.scopes[si] ? cl.scopes[si].x : cl.trunkX + C.sGap;',
'      const dots = sc.commits.map(c => ({ y: toY(c.date), prefix: c.prefix, msg: c.msg, date: c.date }));',
'      const bSegs = sc.blockedSegments.map(seg => ({ y1: toY(seg.start), y2: toY(seg.end) }));',
'      return {',
'        name: sc.name, x: sx, status: sc.status,',
'        y1: dots[0].y, y2: dots[dots.length-1].y, dots, blockedSegs: bSegs,',
'        forkY: toY(sc.forkDate), mergeY: sc.mergeDate ? toY(sc.mergeDate) : null,',
'      };',
'    });',
'',
'    return {',
'      trunkX: cl.trunkX, y1, y2, color: tr.color, state: tr.state, op,',
'      name: tr.name, alias: tr.alias, id: tr.id,',
'      trunkDots, scopes: scopeLayouts,',
'    };',
'  });',
'',
'  return { width: totalW, height: topY + trackH + C.mB,',
'    grid, todayY, mainX: C.mainX, mainY1: topY, mainY2: topY + trackH,',
'    mainForks, mainMerges: mainMerges, krCols: krCols.filter(Boolean), topY, labelH: C.labelH };',
'}',
'',
'// 3 prefix colors only',
'const PC = { progress:"#4a9ade", done:"#2bc48a", blocked:"#e5514f" };',
'',
'// 3 dot shapes: circle (progress), diamond (done), square (blocked)',
'function dot(x, y, prefix, color, r, o) {',
'  r = r||C.dotR; o = o||1;',
'  const fc = PC[prefix] || color;',
'  const sw = 3;',
'  switch(prefix) {',
'    case "progress":',
'      return \'<circle cx="\'+x+\'" cy="\'+y+\'" r="\'+r+\'" fill="\'+fc+\'" stroke="#fff" stroke-width="\'+sw+\'" paint-order="stroke" opacity="\'+o+\'"/>\';',
'    case "done":',
'      return \'<rect x="\'+(-r)+\'" y="\'+(-r)+\'" width="\'+(r*2)+\'" height="\'+(r*2)+\'" rx="2" transform="translate(\'+x+\',\'+y+\') rotate(45)" fill="\'+fc+\'" stroke="#fff" stroke-width="\'+sw+\'" paint-order="stroke" opacity="\'+o+\'"/>\';',
'    case "blocked":',
'      return \'<rect x="\'+(x-r)+\'" y="\'+(y-r)+\'" width="\'+(r*2)+\'" height="\'+(r*2)+\'" rx="2" fill="\'+fc+\'" stroke="#fff" stroke-width="\'+sw+\'" paint-order="stroke" opacity="\'+o+\'"/>\'',
'        + \'<line x1="\'+(x-r*.45)+\'" y1="\'+y+\'" x2="\'+(x+r*.45)+\'" y2="\'+y+\'" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity="\'+o+\'"/>\';',
'    default:',
'      return \'<circle cx="\'+x+\'" cy="\'+y+\'" r="\'+r+\'" fill="\'+fc+\'" stroke="#fff" stroke-width="\'+sw+\'" paint-order="stroke" opacity="\'+o+\'"/>\';',
'  }',
'}',
'',
'function esc(s) { return s.replace(/&/g,"&amp;").replace(/"/g,"&quot;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }',
'',
'// Vertical SVG renderer',
'function renderSVG(L) {',
'  const { width, height, grid, todayY, mainX, mainY1, mainY2,',
'    mainForks, mainMerges, krCols, topY, labelH } = L;',
'  const trackH = mainY2 - mainY1;',
'  const r = C.arcR;',
'  let s = \'<svg width="\'+width+\'" height="\'+height+\'" viewBox="0 0 \'+width+\' \'+height+\'" xmlns="http://www.w3.org/2000/svg">\';',
'',
'  // Grid lines',
'  for (const g of grid) {',
'    s += \'<line x1="\'+(C.mL-4)+\'" y1="\'+g.y+\'" x2="\'+width+\'" y2="\'+g.y+\'" stroke="#e4e4e7" stroke-width="0.5" stroke-dasharray="2,6" opacity="0.5"/>\';',
'    s += \'<text x="\'+(C.mL-8)+\'" y="\'+(g.y+3)+\'" fill="#a1a1aa" font-size="9" text-anchor="end" font-family="JetBrains Mono, ui-monospace, monospace">\'+g.label+\'</text>\';',
'  }',
'',
'  // Today marker',
'  if (todayY !== null) {',
'    s += \'<line x1="\'+(C.mL-4)+\'" y1="\'+todayY+\'" x2="\'+width+\'" y2="\'+todayY+\'" stroke="#18181b" stroke-width="1" stroke-dasharray="6,4" opacity="0.1"/>\';',
'    s += \'<text x="\'+(C.mL-8)+\'" y="\'+(todayY+3)+\'" fill="#18181b" font-size="9" text-anchor="end" opacity="0.35" font-family="JetBrains Mono, ui-monospace, monospace" font-weight="600">today</text>\';',
'  }',
'',
'  // Main rail — clean backbone line, NO dots',
'  s += \'<line x1="\'+mainX+\'" y1="\'+mainY1+\'" x2="\'+mainX+\'" y2="\'+mainY2+\'" stroke="#d4d4d8" stroke-width="8" stroke-linecap="round" opacity="0.15"/>\';',
'  s += \'<line x1="\'+mainX+\'" y1="\'+mainY1+\'" x2="\'+mainX+\'" y2="\'+mainY2+\'" stroke="#c4c4cc" stroke-width="\'+C.mainW+\'" stroke-linecap="round"/>\';',
'  s += \'<text x="\'+mainX+\'" y="\'+(topY-14)+\'" fill="#a1a1aa" font-size="10" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-weight="500">main</text>\';',
'',
'  // Fork arcs — KR tracks branching from main',
'  for (const f of mainForks) {',
'    const mx = (mainX + f.targetX) / 2;',
'    s += \'<path d="M \'+mainX+\',\'+f.y+\' C \'+mx+\',\'+f.y+\' \'+mx+\',\'+f.y+\' \'+f.targetX+\',\'+f.y+\'" fill="none" stroke="\'+f.color+\'" stroke-width="2" stroke-linecap="round" opacity="0.2" stroke-dasharray="4,3"/>\';',
'    s += \'<circle cx="\'+mainX+\'" cy="\'+f.y+\'" r="3.5" fill="\'+f.color+\'" opacity="0.3"/>\';',
'  }',
'',
'  // Merge-back arcs — KR tracks returning to main',
'  for (const m of (mainMerges || [])) {',
'    const mx = (mainX + m.targetX) / 2;',
'    s += \'<path d="M \'+m.targetX+\',\'+m.y+\' C \'+mx+\',\'+m.y+\' \'+mx+\',\'+m.y+\' \'+mainX+\',\'+m.y+\'" fill="none" stroke="\'+m.color+\'" stroke-width="2" stroke-linecap="round" opacity="0.2" stroke-dasharray="4,3"/>\';',
'    s += \'<circle cx="\'+mainX+\'" cy="\'+m.y+\'" r="3.5" fill="\'+m.color+\'" opacity="0.3"/>\';',
'  }',
'',
'  // KR tracks',
'  for (const kr of krCols) {',
'    const { trunkX, y1, y2, color, state, op, name, alias, id, trunkDots, scopes } = kr;',
'',
'    // Label',
'    const lblY = Math.max(y1 - 12, topY - 34);',
'    s += \'<text x="\'+trunkX+\'" y="\'+(lblY-22)+\'" fill="\'+color+\'" opacity="\'+op+\'" font-size="14" font-weight="600" text-anchor="middle" font-family="Outfit, ui-sans-serif, system-ui, sans-serif">\'+name+\'</text>\';',
'    s += \'<text x="\'+trunkX+\'" y="\'+(lblY-6)+\'" fill="#71717a" opacity="\'+op+\'" font-size="10" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace">\'+alias+\'</text>\';',
'',
'    if (state === "canceled")',
'      s += \'<text x="\'+trunkX+\'" y="\'+(lblY+10)+\'" fill="#ef4444" opacity="0.5" font-size="8" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" letter-spacing="0.06em">CANCELED</text>\';',
'    else if (state === "frozen")',
'      s += \'<text x="\'+trunkX+\'" y="\'+(lblY+10)+\'" fill="#0891b2" opacity="0.6" font-size="8" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" letter-spacing="0.06em">FROZEN</text>\';',
'',
'    // Trunk line (thick)',
'    const ty1 = y1 - 8, ty2 = y2 + 8;',
'    if (op > 0.5)',
'      s += \'<line x1="\'+trunkX+\'" y1="\'+ty1+\'" x2="\'+trunkX+\'" y2="\'+ty2+\'" stroke="\'+color+\'" stroke-width="20" stroke-linecap="round" opacity="0.04"/>\';',
'    s += \'<line x1="\'+trunkX+\'" y1="\'+ty1+\'" x2="\'+trunkX+\'" y2="\'+ty2+\'" stroke="\'+color+\'" stroke-width="\'+C.trunkW+\'" stroke-linecap="round" opacity="\'+op+\'"/>\';',
'',
'    // Trunk dots',
'    for (const d of trunkDots) {',
'      s += \'<g class="st" data-prefix="\'+d.prefix+\'" data-msg="\'+esc(d.msg)+\'" data-date="\'+d.date+\'">\';',
'      s += dot(trunkX, d.y, d.prefix, color, C.dotR, op);',
'      if (d.milestone)',
'        s += \'<circle cx="\'+trunkX+\'" cy="\'+d.y+\'" r="\'+(C.dotR+6)+\'" fill="none" stroke="\'+PC.done+\'" stroke-width="2" opacity="0.45"/>\';',
'      s += \'</g>\';',
'    }',
'',
'    // Scope sub-tracks (thin lines)',
'    for (const sc of scopes) {',
'      const sop = op * 0.65;',
'',
'      // Fork arc from trunk',
'      const dx = sc.x - trunkX;',
'      if (dx > 2 * r) {',
'        s += \'<path d="M \'+trunkX+\',\'+(sc.forkY-r)+\' A \'+r+\',\'+r+\' 0 0,0 \'+(trunkX+r)+\',\'+sc.forkY+\' L \'+(sc.x-r)+\',\'+sc.forkY+\' A \'+r+\',\'+r+\' 0 0,1 \'+sc.x+\',\'+(sc.forkY+r)+\'" fill="none" stroke="\'+color+\'" stroke-width="\'+C.scopeW+\'" stroke-linecap="round" opacity="\'+sop+\'"/>\';',
'      } else {',
'        s += \'<path d="M \'+trunkX+\',\'+sc.forkY+\' Q \'+sc.x+\',\'+sc.forkY+\' \'+sc.x+\',\'+(sc.forkY+dx)+\'" fill="none" stroke="\'+color+\'" stroke-width="\'+C.scopeW+\'" stroke-linecap="round" opacity="\'+sop+\'"/>\';',
'      }',
'      s += \'<circle cx="\'+trunkX+\'" cy="\'+sc.forkY+\'" r="3.5" fill="\'+color+\'" opacity="\'+(sop*0.6)+\'"/>\';',
'',
'      // Scope line (split around blocked segments)',
'      const sLineY1 = sc.forkY + (dx > 2*r ? r : dx * 0.5);',
'      let sLineY2 = sc.y2 + 6;',
'      if (sc.blockedSegs.length === 0) {',
'        s += \'<line x1="\'+sc.x+\'" y1="\'+sLineY1+\'" x2="\'+sc.x+\'" y2="\'+sLineY2+\'" stroke="\'+color+\'" stroke-width="\'+C.scopeW+\'" stroke-linecap="round" opacity="\'+sop+\'"/>\';',
'      } else {',
'        var sortedSegs = sc.blockedSegs.slice().sort(function(a,b){ return a.y1 - b.y1; });',
'        var curY = sLineY1;',
'        for (var si = 0; si < sortedSegs.length; si++) {',
'          if (sortedSegs[si].y1 > curY) {',
'            s += \'<line x1="\'+sc.x+\'" y1="\'+curY+\'" x2="\'+sc.x+\'" y2="\'+sortedSegs[si].y1+\'" stroke="\'+color+\'" stroke-width="\'+C.scopeW+\'" stroke-linecap="round" opacity="\'+sop+\'"/>\';',
'          }',
'          curY = sortedSegs[si].y2;',
'        }',
'        if (curY < sLineY2) {',
'          s += \'<line x1="\'+sc.x+\'" y1="\'+curY+\'" x2="\'+sc.x+\'" y2="\'+sLineY2+\'" stroke="\'+color+\'" stroke-width="\'+C.scopeW+\'" stroke-linecap="round" opacity="\'+sop+\'"/>\';',
'        }',
'      }',
'',
'      // Scope label',
'      s += \'<text x="\'+(sc.x+10)+\'" y="\'+(sc.forkY+r+5)+\'" fill="#71717a" opacity="\'+sop+\'" font-size="9" font-family="JetBrains Mono, ui-monospace, monospace">\'+sc.name+\'</text>\';',
'',
'      // Merge-back arc (done scope)',
'      if (sc.mergeY) {',
'        const my = sc.mergeY;',
'        if (dx > 2*r) {',
'          s += \'<path d="M \'+sc.x+\',\'+(my-r)+\' A \'+r+\',\'+r+\' 0 0,1 \'+(sc.x-r)+\',\'+my+\' L \'+(trunkX+r)+\',\'+my+\' A \'+r+\',\'+r+\' 0 0,0 \'+trunkX+\',\'+(my+r)+\'" fill="none" stroke="\'+color+\'" stroke-width="\'+C.scopeW+\'" stroke-linecap="round" opacity="\'+sop+\'"/>\';',
'        } else {',
'          s += \'<line x1="\'+sc.x+\'" y1="\'+my+\'" x2="\'+trunkX+\'" y2="\'+my+\'" stroke="\'+color+\'" stroke-width="\'+C.scopeW+\'" opacity="\'+sop+\'"/>\';',
'        }',
'        s += \'<circle cx="\'+trunkX+\'" cy="\'+my+\'" r="3.5" fill="\'+color+\'" opacity="\'+(sop*0.6)+\'"/>\';',
'      } else if (sc.status === "active") {',
'        s += \'<line x1="\'+sc.x+\'" y1="\'+sLineY2+\'" x2="\'+sc.x+\'" y2="\'+(sLineY2+16)+\'" stroke="\'+color+\'" stroke-width="\'+C.scopeW+\'" stroke-dasharray="4,4" opacity="\'+(sop*0.4)+\'"/>\';',
'      } else if (sc.status === "blocked") {',
'        s += \'<line x1="\'+sc.x+\'" y1="\'+sLineY2+\'" x2="\'+sc.x+\'" y2="\'+(sLineY2+16)+\'" stroke="#ef4444" stroke-width="\'+C.scopeW+\'" stroke-dasharray="3,3" opacity="0.5"/>\';',
'      }',
'',
'      // Blocked segments (red dashed)',
'      for (const seg of sc.blockedSegs) {',
'        s += \'<line x1="\'+sc.x+\'" y1="\'+seg.y1+\'" x2="\'+sc.x+\'" y2="\'+seg.y2+\'" stroke="#ef4444" stroke-width="\'+(C.scopeW+1.2)+\'" stroke-dasharray="5,3" opacity="0.4"/>\';',
'      }',
'',
'      // Scope dots',
'      for (const d of sc.dots) {',
'        s += \'<g class="st" data-prefix="\'+d.prefix+\'" data-msg="\'+esc(d.msg)+\'" data-date="\'+d.date+\'">\';',
'        s += dot(sc.x, d.y, d.prefix, color, C.sDotR, sop);',
'        s += \'</g>\';',
'      }',
'    }',
'  }',
'',
'  s += "</svg>";',
'  return s;',
'}',
'',
'// Tooltips',
'var _activeSt = null;',
'function showTT(st) {',
'  const tt = document.getElementById("tt");',
'  const p = st.dataset.prefix, m = st.dataset.msg, d = st.dataset.date;',
'  tt.innerHTML = \'<div class="tp" style="color:\'+(PC[p]||"#52525b")+\'">\'+p+\'</div><div class="tm">\'+m+\'</div><div class="td">\'+d+\'</div>\';',
'  const r = st.getBoundingClientRect();',
'  tt.style.left = (r.right + 8) + "px";',
'  tt.style.top = (r.top - 4) + "px";',
'  tt.style.transform = "none";',
'  tt.classList.add("v");',
'  _activeSt = st;',
'}',
'function hideTT() {',
'  document.getElementById("tt").classList.remove("v");',
'  _activeSt = null;',
'}',
'function addTT(el) {',
'  for (const st of el.querySelectorAll(".st")) {',
'    st.addEventListener("click", (e) => {',
'      e.stopPropagation();',
'      if (_activeSt === st) { hideTT(); return; }',
'      showTT(st);',
'    });',
'    st.addEventListener("mouseenter", () => { if (!_activeSt) showTT(st); });',
'    st.addEventListener("mouseleave", () => { if (_activeSt !== st) hideTT(); });',
'  }',
'  document.addEventListener("click", () => hideTT());',
'}',
'',
'// Legend — 3 events + 2 track weights',
'function renderLegend() {',
'  const bar = document.getElementById("legend");',
'  const items = [{p:"progress",l:"progress"},{p:"done",l:"done"},{p:"blocked",l:"blocked"}];',
'  let h = \'<div class="lg"><span class="lt">Events</span>\';',
'  for (const i of items)',
'    h += \'<span class="li"><svg viewBox="0 0 20 20">\'+dot(10,10,i.p,PC[i.p],7,1)+\'</svg>\'+i.l+\'</span>\';',
'  h += \'</div><div class="lg"><span class="lt">Tracks</span>\';',
'  h += \'<span class="li"><svg viewBox="0 0 16 16"><line x1="8" y1="1" x2="8" y2="15" stroke="#d4d4d8" stroke-width="3" stroke-linecap="round"/></svg>main</span>\';',
'  h += \'<span class="li"><svg viewBox="0 0 16 16"><line x1="8" y1="1" x2="8" y2="15" stroke="#71717a" stroke-width="5" stroke-linecap="round"/></svg>trunk</span>\';',
'  h += \'<span class="li"><svg viewBox="0 0 16 16"><line x1="8" y1="1" x2="8" y2="15" stroke="#71717a" stroke-width="2.5" stroke-linecap="round" opacity="0.45"/></svg>scope</span>\';',
'  h += \'</div>\';',
'  bar.innerHTML = h;',
'}',
'',
'// PNG export',
'function exportPNG() {',
'  const card = document.getElementById("card");',
'  const svg = card.querySelector("svg");',
'  if (!svg) return;',
'',
'  const svgW = +svg.getAttribute("width");',
'  const svgH = +svg.getAttribute("height");',
'  const headerH = 56, legendH = 48, pad = 32;',
'  const totalW = Math.max(svgW, 500) + pad * 2;',
'  const totalH = headerH + svgH + legendH + pad * 2;',
'  const scale = 2;',
'',
'  const canvas = document.createElement("canvas");',
'  canvas.width = totalW * scale;',
'  canvas.height = totalH * scale;',
'  const ctx = canvas.getContext("2d");',
'  ctx.scale(scale, scale);',
'',
'  const cr = 24;',
'  ctx.fillStyle = "#ffffff";',
'  ctx.beginPath();',
'  ctx.roundRect(0, 0, totalW, totalH, cr);',
'  ctx.fill();',
'',
'  ctx.fillStyle = "#18181b";',
'  ctx.font = "600 20px Outfit, ui-sans-serif, system-ui, sans-serif";',
'  ctx.fillText("Metro map", pad, pad + 24);',
'  ctx.fillStyle = "#a1a1aa";',
'  ctx.font = "12px \'JetBrains Mono\', ui-monospace, monospace";',
'  ctx.fillText("' + qLabel + ' \\u00b7 vertical topology", pad + ctx.measureText("Metro map  ").width + 8, pad + 24);',
'',
'  ctx.strokeStyle = "#e4e4e7";',
'  ctx.lineWidth = 1;',
'  ctx.beginPath();',
'  ctx.moveTo(0, headerH + pad - 4);',
'  ctx.lineTo(totalW, headerH + pad - 4);',
'  ctx.stroke();',
'',
'  const svgData = new XMLSerializer().serializeToString(svg);',
'  const blob = new Blob([svgData], { type: "image/svg+xml;charset=utf-8" });',
'  const url = URL.createObjectURL(blob);',
'  const img = new Image();',
'  img.onload = () => {',
'    ctx.drawImage(img, pad, headerH + pad);',
'    URL.revokeObjectURL(url);',
'',
'    const legendY = headerH + pad + svgH + 4;',
'    ctx.strokeStyle = "#e4e4e7";',
'    ctx.beginPath();',
'    ctx.moveTo(0, legendY);',
'    ctx.lineTo(totalW, legendY);',
'    ctx.stroke();',
'',
'    ctx.fillStyle = "#a1a1aa";',
'    ctx.font = "10px ui-monospace, monospace";',
'    const labels = ["progress", "done", "blocked"];',
'    const colors = [PC.progress, PC.done, PC.blocked];',
'    let lx = pad;',
'    ctx.fillStyle = "#d4d4d8";',
'    ctx.font = "600 9px \'Outfit\', ui-sans-serif, system-ui, sans-serif";',
'    ctx.fillText("EVENTS", lx, legendY + 24);',
'    lx += 56;',
'    ctx.font = "10px \'JetBrains Mono\', ui-monospace, monospace";',
'    for (let i = 0; i < labels.length; i++) {',
'      ctx.fillStyle = colors[i];',
'      ctx.beginPath();',
'      ctx.arc(lx + 4, legendY + 20, 3.5, 0, Math.PI * 2);',
'      ctx.fill();',
'      ctx.fillStyle = "#a1a1aa";',
'      ctx.fillText(labels[i], lx + 12, legendY + 24);',
'      lx += ctx.measureText(labels[i]).width + 24;',
'    }',
'',
'    const a = document.createElement("a");',
'    a.download = "okr-metro-' + qLabel.replace(/ /g, '-') + '.png";',
'    a.href = canvas.toDataURL("image/png");',
'    a.click();',
'  };',
'  img.src = url;',
'}',
'',
'// Main',
'(function() {',
'  const wrap = document.getElementById("wrap");',
'  let html = "";',
'  for (const q of DATA.quarters) {',
'    html += \'<div class="q-section"><div class="q-label">\' + q.label + \'</div>\';',
'    const tracks = buildTracks(q);',
'    const layout = computeLayout(tracks, q);',
'    html += renderSVG(layout);',
'    html += \'</div>\';',
'  }',
'  wrap.innerHTML = html;',
'  addTT(wrap);',
'  renderLegend();',
'})();',
'</script>',
'</body>',
'</html>',
  ].join('\n');
}
