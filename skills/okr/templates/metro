#!/usr/bin/env node
'use strict';

const { execSync } = require('child_process');
const { writeFileSync, mkdirSync } = require('fs');
const { resolve } = require('path');
const { homedir } = require('os');

const OKR_DIR = resolve(homedir(), '.okr');
const OUT_FILE = resolve(OKR_DIR, 'log', 'metro.html');

// ── CLI args ──────────────────────────────────────────
const args = process.argv.slice(2);
if (args.includes('--help') || args.includes('-h')) {
  console.log('Usage: metro [options]\n\nOptions:\n  --quarter 2026Q1   Render a specific quarter\n  --no-open          Generate without opening in browser\n  --help             Show this help');
  process.exit(0);
}
const flagQuarter = args.includes('--quarter') ? args[args.indexOf('--quarter') + 1] : null;
const noOpen = args.includes('--no-open');

// ── Helpers ───────────────────────────────────────────
function git(cmd) {
  return execSync('git -C "' + OKR_DIR + '" ' + cmd, { encoding: 'utf8' }).trim();
}

// ── Step 1: Parse okr.md from main HEAD ───────────────
const okrMd = git('show main:okr.md');
const lines = okrMd.split('\n');

function makeQuarter(y, q) {
  const startMonth = (q - 1) * 3;
  const start = y + '-' + String(startMonth + 1).padStart(2, '0') + '-01';
  const endMonth = startMonth + 3;
  const endYear = endMonth > 12 ? y + 1 : y;
  const endM = endMonth > 12 ? endMonth - 12 : endMonth;
  const lastDay = new Date(endYear, endM, 0).getDate();
  const end = endYear + '-' + String(endM).padStart(2, '0') + '-' + String(lastDay).padStart(2, '0');
  return { year: y, q: q, start: start, end: end, label: y + 'Q' + q };
}

// Split okr.md into quarter sections
const quarterSections = [];
const headerRe = /^#\s+OKR\s+Spec\s+(\d{4})\s+Q(\d)/;
let currentSection = null;
for (let li = 0; li < lines.length; li++) {
  const hm = lines[li].match(headerRe);
  if (hm) {
    currentSection = { quarter: makeQuarter(+hm[1], +hm[2]), startLine: li, endLine: lines.length };
    quarterSections.push(currentSection);
    if (quarterSections.length > 1)
      quarterSections[quarterSections.length - 2].endLine = li;
  }
}

if (quarterSections.length === 0) {
  console.error('Could not parse any quarter from okr.md');
  process.exit(1);
}

// Select quarters
var selectedSections = [];
if (flagQuarter) {
  const fm = flagQuarter.match(/^(\d{4})Q(\d)$/i);
  if (!fm) { console.error('Invalid quarter format: ' + flagQuarter + ' (expected e.g. 2026Q1)'); process.exit(1); }
  const target = +fm[1] + 'Q' + +fm[2];
  const found = quarterSections.find(s => s.quarter.label === target);
  if (!found) { console.error('Quarter ' + flagQuarter + ' not found in okr.md'); process.exit(1); }
  selectedSections = [found];
} else {
  selectedSections = quarterSections;
}

var quarter = selectedSections[selectedSections.length - 1].quarter;
if (selectedSections.length > 1) {
  quarter = {
    year: selectedSections[0].quarter.year,
    q: selectedSections[0].quarter.q,
    start: selectedSections[0].quarter.start,
    end: selectedSections[selectedSections.length - 1].quarter.end,
    label: selectedSections.map(s => s.quarter.label).join('+')
  };
}

// Parse KR definitions (with Objective tracking)
const krs = [];
const krRe = /^\*\*KR(\d+)\s+(.+?)\*\*\s+`([\w-]+)`\s+(\d+)%/;
const objRe = /^##\s+O(\d+)\s+/;
for (const sec of selectedSections) {
  const secLines = lines.slice(sec.startLine, sec.endLine);
  var currentObj = 1;
  for (var i = 0; i < secLines.length; i++) {
    const om = secLines[i].match(objRe);
    if (om) { currentObj = +om[1]; continue; }
    const m = secLines[i].match(krRe);
    if (!m) continue;
    const krNum = +m[1];
    const displayName = m[2];
    const alias = m[3];
    const weight = +m[4];

    var state = 'active';
    for (var j = i + 1; j < Math.min(i + 4, secLines.length); j++) {
      if (/\[canceled\]/i.test(secLines[j])) { state = 'canceled'; break; }
      if (/\[frozen\]/i.test(secLines[j])) { state = 'frozen'; break; }
      if (/^\*\*KR/.test(secLines[j])) break;
    }

    krs.push({ num: krNum, name: displayName, alias: alias, weight: weight, state: state, obj: currentObj, qLabel: sec.quarter.label });
  }
}

// ── Step 2: Parse git log (commit-message-based) ──────
// Objective-based color palette
const OBJ_COLORS = {
  1: ['#c0605a', '#e8956a', '#8a4a60'],
  2: ['#4a7e94', '#3a8a6a', '#6a70a8'],
  3: ['#4d8f72', '#5ea584', '#3d7a60'],
  4: ['#8a6ea0', '#9e82b4', '#765a8c'],
};

// 3 KR event prefixes only
const commitRe = /^(progress|done|blocked)\(([^)]+)\):\s*(.+)$/i;
const krRefRe = /^kr(\d+)(?:\/(.+))?$/i;

// Admin event detection
const adminRe = /^(init|revise|close)(?:\(([^)]+)\))?:\s*(.+)$/i;

// Merge commit detection
const mergeRe = /^Merge branch '([^']+)'/;

// Parse all commits from main (includes merged history)
const logLines = git('log main --all --format="%H|%s|%ad|%D" --date=iso').split('\n').filter(Boolean);

// Build per-KR commit lists
const krCommits = new Map();
for (const kr of krs) krCommits.set(kr.num, []);

// Admin events and merge points
const admin = [];
const mergePoints = [];

for (const line of logLines) {
  const parts = line.split('|');
  const hash = parts[0];
  const dateStr = parts[parts.length - 2];
  const refs = parts[parts.length - 1];
  const subject = parts.slice(1, -2).join('|');

  // Merge commits — extract branch name for merge-back arcs
  const mm = subject.match(mergeRe);
  if (mm) {
    const branchName = mm[1];
    const brm = branchName.match(/\d{4}Q\d\/kr\/(\d+)/);
    if (brm) {
      mergePoints.push({ date: dateStr.slice(0, 10), krNum: +brm[1] });
    }
    continue;
  }

  // KR events (from commit message scope)
  const cm = subject.match(commitRe);
  if (cm) {
    const prefix = cm[1].toLowerCase();
    const krRef = cm[2];
    const msg = cm[3];

    const rm = krRef.match(krRefRe);
    if (!rm) continue;

    const krNum = +rm[1];
    const scope = rm[2] || null;

    if (!krCommits.has(krNum)) continue;

    const commit = { date: dateStr.slice(0, 10), prefix: prefix, scope: scope, msg: msg };
    if (/milestone/i.test(msg) || /reached target/i.test(msg)) {
      commit.milestone = true;
    }
    krCommits.get(krNum).push(commit);
    continue;
  }

  // Admin events
  const am = subject.match(adminRe);
  if (am) {
    const type = am[1].toLowerCase();
    const adminRef = am[2] || null;
    const msg = am[3];
    var adminKr = null;
    if (adminRef) {
      const arm = adminRef.match(/^kr(\d+)$/i);
      if (arm) adminKr = +arm[1];
    }
    admin.push({ date: dateStr.slice(0, 10), type: type, msg: msg, kr: adminKr });
    continue;
  }
}

// Sort commits by date for each KR
for (const [, commits] of krCommits) {
  commits.sort(function(a, b) { return a.date.localeCompare(b.date); });
}
admin.sort(function(a, b) { return a.date.localeCompare(b.date); });

// ── Step 3: Detect canceled/frozen from admin events ──
for (const evt of admin) {
  if (evt.kr === null) continue;
  const kr = krs.find(function(k) { return k.num === evt.kr; });
  if (!kr) continue;
  if (/cancel/i.test(evt.msg)) kr.state = 'canceled';
  if (/frozen|freeze/i.test(evt.msg)) kr.state = 'frozen';
}

// ── Step 4: Build DATA object (per-quarter) ───────────
const today = new Date().toISOString().slice(0, 10);

// Global column slots
const objMaxKrs = {};
for (const sec of selectedSections) {
  const qKrs = krs.filter(function(kr) { return kr.qLabel === sec.quarter.label; });
  const objCount = {};
  for (const kr of qKrs) {
    objCount[kr.obj] = (objCount[kr.obj] || 0) + 1;
  }
  for (const obj in objCount) {
    objMaxKrs[obj] = Math.max(objMaxKrs[obj] || 0, objCount[obj]);
  }
}
const objOrder = Object.keys(objMaxKrs).sort(function(a,b) { return +a - +b; });
const globalSlots = [];
for (const obj of objOrder) {
  for (var si = 0; si < objMaxKrs[obj]; si++) {
    globalSlots.push({ obj: +obj, idx: si });
  }
}

const quarters = selectedSections.map(function(sec) {
  const qKrs = krs.filter(function(kr) { return kr.qLabel === sec.quarter.label; });
  const objCounter = {};
  // Reset color index per quarter so same O gets same colors each quarter
  const qObjKrIdx = {};
  const dataKrs = qKrs.map(function(kr) {
    const commits = krCommits.get(kr.num) || [];
    const objFamily = OBJ_COLORS[kr.obj] || OBJ_COLORS[1];
    if (!qObjKrIdx[kr.obj]) qObjKrIdx[kr.obj] = 0;
    const color = objFamily[qObjKrIdx[kr.obj]++ % objFamily.length];
    const krObjIdx = objCounter[kr.obj] || 0;
    objCounter[kr.obj] = krObjIdx + 1;
    const slotIdx = globalSlots.findIndex(function(s) { return s.obj === kr.obj && s.idx === krObjIdx; });

    const commitArr = commits.map(function(c) {
      const obj = { date: c.date, prefix: c.prefix, scope: c.scope, msg: c.msg };
      if (c.milestone) obj.milestone = true;
      return obj;
    });

    // Find merge point for this KR
    const mp = mergePoints.find(function(m) { return m.krNum === kr.num; });
    const mergeDate = mp ? mp.date : null;

    return { id: kr.num, name: kr.name, alias: kr.alias, color: color, state: kr.state, commits: commitArr, slotIdx: slotIdx, mergeDate: mergeDate };
  });

  // Filter admin events to this quarter
  const qKrIds = new Set(qKrs.map(function(k) { return k.num; }));
  const qStart = sec.quarter.start;
  const qEnd = sec.quarter.end;
  const qAdmin = admin.filter(function(a) {
    if (a.date < qStart || a.date > qEnd) return false;
    return a.kr === null || qKrIds.has(a.kr);
  }).map(function(a) { return { date: a.date, type: a.type, msg: a.msg, kr: a.kr }; });

  return { label: sec.quarter.label, quarter: sec.quarter, krs: dataKrs, admin: qAdmin };
});

const DATA = { quarters: quarters, today: today, totalSlots: globalSlots.length };

// ── Step 5: Generate HTML ─────────────────────────────
const quarterLabel = selectedSections.length > 1
  ? selectedSections.map(s => s.quarter.year + ' Q' + s.quarter.q).join(' + ')
  : quarter.year + ' Q' + quarter.q;
const dataJson = JSON.stringify(DATA, null, 2);

