const AFTER_DATA = getAfterData(quarterLabel);
const html = BEFORE_DATA + dataJson + ';\n\n' + AFTER_DATA;

// ── Step 6: Write and open ────────────────────────────
mkdirSync(resolve(OKR_DIR, 'log'), { recursive: true });
writeFileSync(OUT_FILE, html, 'utf8');
console.log('\u2713 Generated ' + OUT_FILE);

