#!/usr/bin/env python3
"""herd-read <project> [--since N] [--json]

Print board posts with seq > N (default 0). --json prints raw JSONL records.
<project>: a path, or a bare name resolved under $HERD_ROOT (default ~/herd).
"""
import json
import os
import sys


def resolve_project_dir(project: str) -> str:
    if project.startswith(("/", "./", "../")) or project == ".":
        return os.path.abspath(project)
    if project == "~" or project.startswith("~/"):
        return os.path.abspath(os.path.expanduser(project))
    root = os.path.expanduser(os.environ.get("HERD_ROOT", "~/herd"))
    return os.path.abspath(os.path.join(root, project))


def parse_args(argv: list[str]) -> tuple[str, int, str] | None:
    if not argv:
        sys.stderr.write("usage: herd-read <project> [--since N] [--json]\n")
        return None
    project = argv[0]
    since = 0
    fmt = "text"
    idx = 1
    while idx < len(argv):
        arg = argv[idx]
        if arg == "--since":
            if idx + 1 >= len(argv):
                sys.stderr.write("herd-read: --since needs a number\n")
                return None
            try:
                since = int(argv[idx + 1])
            except ValueError:
                sys.stderr.write(f"herd-read: invalid --since {argv[idx + 1]}\n")
                return None
            idx += 2
        elif arg == "--json":
            fmt = "json"
            idx += 1
        else:
            sys.stderr.write(f"herd-read: bad arg {arg}\n")
            return None
    return project, since, fmt


def main(argv: list[str]) -> int:
    parsed = parse_args(argv)
    if parsed is None:
        return 2
    project, since, fmt = parsed
    board_path = os.path.join(resolve_project_dir(project), "board.jsonl")
    if not os.path.isfile(board_path):
        return 0
    with open(board_path, encoding="utf-8") as fh:
        for raw in fh:
            line = raw.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
                seq = int(rec.get("seq", 0))
            except (json.JSONDecodeError, ValueError, TypeError, AttributeError):
                continue
            if seq <= since:
                continue
            if fmt == "json":
                sys.stdout.write(json.dumps(rec, ensure_ascii=False) + "\n")
            else:
                sys.stdout.write(f"#{seq} {rec['time']} {rec['agent']}: {rec['text']}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
