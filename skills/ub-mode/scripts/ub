#!/bin/sh
# ub — run vendored quality instruments (crapper, dryer, mutator) or static gate (check).
#   ub <crapper|dryer|mutator> [tool args…]    run in the current directory, like the upstream ./crapper
#   ub check [--changed] [--json] [path …]     cross-language test-honesty and silent-fallback gate
#   ub setup                                   build the environment now (otherwise the first run does it)
#   ub where                                   print the environment path and the pinned upstream commits
#
# The three upstream tools are copied into ../tools (see tools/VENDOR). They share one Python environment,
# built once with uv in $UB_HOME (default ~/.cache/ub-mode). It lives outside the skill folder, so reinstalling
# the skill keeps it; a stamp of the vendored sources makes the next run rebuild it after the tools change.
set -eu
HERE=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
SKILL_DIR=$(CDPATH='' cd -- "$HERE/.." && pwd)
TOOLS=$(CDPATH='' cd -- "$HERE/../tools" && pwd)
UB_HOME=${UB_HOME:-"${XDG_CACHE_HOME:-$HOME/.cache}/ub-mode"}
VENV="$UB_HOME/venv"
PY="$VENV/bin/python"

stamp() {
  # Changes whenever a vendored file or the pinned dependency list changes.
  (cd "$TOOLS" && find . -type f \( -name '*.py' -o -name 'pyproject.toml' -o -name 'requirements.txt' \) | LC_ALL=C sort | xargs cat) |
    if command -v shasum >/dev/null; then shasum -a 256; else sha256sum; fi | cut -c1-16
}

build() {
  command -v uv >/dev/null || { echo "ub: needs uv (https://docs.astral.sh/uv/): brew install uv, or pipx install uv" >&2; exit 1; }
  echo "ub: building $VENV (one time, a few seconds)" >&2
  rm -rf "$VENV" "$UB_HOME/src"
  mkdir -p "$UB_HOME/src"
  # Build from a copy: setuptools writes build/ and *.egg-info next to the sources it builds.
  cp -R "$TOOLS/crapper" "$TOOLS/dryer" "$TOOLS/mutator" "$UB_HOME/src/"
  uv venv --quiet --python '>=3.11,<3.15' "$VENV" >&2
  uv pip install --quiet --python "$PY" -r "$TOOLS/requirements.txt" \
    "$UB_HOME/src/crapper" "$UB_HOME/src/dryer" "$UB_HOME/src/mutator" >&2
  rm -rf "$UB_HOME/src"
  stamp >"$VENV/.ub-stamp"
}

ready() {
  [ -x "$PY" ] && [ -f "$VENV/.ub-stamp" ] && [ "$(cat "$VENV/.ub-stamp")" = "$(stamp)" ]
}

is_python_project() {
  [ -f pyproject.toml ] || [ -f setup.py ] || [ -f setup.cfg ] || [ -f pytest.ini ] || [ -f conftest.py ]
}

dir_has_py() {
  if git -C "$1" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$1" ls-files -co --exclude-standard -- '*.py' ':!:*node_modules*' ':!:*.venv*' ':!:*venv*' 2>/dev/null | head -n 1 | grep -q .
    return $?
  fi
  find "$1" \
    \( -name .git -o -name node_modules -o -name .venv -o -name venv -o -name dist -o -name target -o -name build -o -name __pycache__ \) -prune \
    -o -type f -name '*.py' -print 2>/dev/null | head -n 1 | grep -q .
}

changed_has_py() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || return 1
  git status --porcelain -z -uall 2>/dev/null | tr '\0' '\n' | grep -v '^D\|^ D' | grep -q '\.py$'
}

project_uses_pytest() {
  [ -f pytest.ini ] || [ -f conftest.py ] && return 0
  for cfg in pyproject.toml setup.cfg tox.ini; do
    [ -f "$cfg" ] && grep -q "pytest" "$cfg" && return 0
  done
  return 1
}

python_preflight() {
  tool=$1
  shift
  need_coverage=1
  need_pytest=1
  is_changed=0
  has_py_target=0
  has_non_py_file=0
  has_dir_target=0
  dir_py=0
  has_positional=0
  skip_next=0
  for arg in "$@"; do
    if [ "$skip_next" -eq 1 ]; then
      skip_next=0
      continue
    fi
    case "$arg" in
      -h|--help) return 0 ;;
      --changed) is_changed=1 ;;
      --no-coverage)
        [ "$tool" = "crapper" ] && return 0
        need_coverage=0 ;;
      --use-existing-coverage)
        [ "$tool" = "crapper" ] && return 0
        need_coverage=0 ;;
      --coverage-command)
        [ "$tool" = "crapper" ] && return 0
        skip_next=1 ;;
      --coverage-command=*)
        [ "$tool" = "crapper" ] && return 0 ;;
      --scan)
        [ "$tool" = "mutator" ] && return 0 ;;
      --test-command)
        [ "$tool" = "mutator" ] && need_pytest=0
        skip_next=1 ;;
      --test-command=*)
        [ "$tool" = "mutator" ] && need_pytest=0 ;;
      --root|-s|--source-root|--threshold|-j|--jobs|--timeout)
        skip_next=1 ;;
      -*) ;;
      *)
        has_positional=1
        case "$arg" in
          *.py) has_py_target=1 ;;
          *)
            if [ -d "$arg" ]; then
              has_dir_target=1
              dir_has_py "$arg" && dir_py=1
            elif [ -f "$arg" ]; then
              has_non_py_file=1
            fi ;;
        esac ;;
    esac
  done
  if [ "$need_coverage" -eq 0 ] && [ "$need_pytest" -eq 0 ]; then
    return 0
  fi
  if [ "$has_py_target" -eq 1 ]; then
    :
  elif [ "$has_dir_target" -eq 1 ]; then
    [ "$dir_py" -eq 1 ] || return 0
  elif [ "$has_positional" -eq 1 ] && [ "$has_non_py_file" -eq 1 ]; then
    return 0
  elif [ "$is_changed" -eq 1 ] && [ "$has_positional" -eq 0 ]; then
    changed_has_py || return 0
  else
    is_python_project || dir_has_py . || return 0
  fi
  proj_py=""
  for rel in .venv/bin/python venv/bin/python; do
    if [ -x "$rel" ]; then
      proj_py="$rel"
      break
    fi
  done
  if [ -z "$proj_py" ]; then
    echo "ub: Python target requires .venv before running '$tool' (otherwise coverage reads 0% or mutator runs in ub's own venv)." >&2
    if [ -f pyproject.toml ] || [ -f setup.py ]; then
      echo "    Fix: uv venv && uv pip install -e . coverage pytest" >&2
    else
      echo "    Fix: uv venv && uv pip install --python .venv/bin/python coverage pytest" >&2
    fi
    exit 2
  fi
  if [ "$need_coverage" -eq 1 ] && ! "$proj_py" -c "import coverage" >/dev/null 2>&1; then
    echo "ub: $proj_py is missing 'coverage' (uv venv omits pip, so $tool cannot auto-install it)." >&2
    echo "    Fix: uv pip install --python $proj_py coverage" >&2
    exit 2
  fi
  if [ "$need_pytest" -eq 1 ] && project_uses_pytest && ! "$proj_py" -c "import pytest" >/dev/null 2>&1; then
    echo "ub: $proj_py is missing 'pytest'." >&2
    echo "    Fix: uv pip install --python $proj_py pytest" >&2
    exit 2
  fi
}

cmd=${1:-}
case "$cmd" in
  crapper|mutator)
    shift
    python_preflight "$cmd" "$@"
    ready || build
    exec "$PY" -m "$cmd" "$@"
    ;;
  dryer)
    shift
    ready || build
    exec "$PY" -m "$cmd" "$@"
    ;;
  check)
    shift
    ready || build
    PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$SKILL_DIR" exec "$PY" -P -m check.cli "$@"
    ;;
  setup)
    build
    echo "ub: ready ($("$PY" --version))"
    ;;
  where)
    echo "env: $VENV"
    cat "$TOOLS/VENDOR"
    ;;
  *)
    sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 64
    ;;
esac
